<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- These brush instances stay alive for the whole app lifetime; ThemeManager
         mutates their Color in place (rather than swapping the dictionary) so this
         Transition animates every color smoothly whenever the theme changes. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.4" Easing="CubicEaseInOut" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.4" Easing="CubicEaseInOut" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#252526">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.4" Easing="CubicEaseInOut" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#3C3C3C">
