<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="IdeBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2D2E" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#37373D" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="RunGreenBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="StopRedBrush" Color="#F14C4C" />
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#181818" />

</ResourceDictionary>
