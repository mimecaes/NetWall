    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStops>
            <GradientStop Offset="0" Color="#387F77DD" />
            <GradientStop Offset="0.5" Color="#1C7F77DD" />
            <GradientStop Offset="1" Color="#007F77DD" />
        </GradientStops>
    </LinearGradientBrush>

