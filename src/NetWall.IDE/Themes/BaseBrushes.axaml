<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0B10">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#131319">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#0E0E14">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush" Color="#7F77DD">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="Accent2Brush" Color="#5DCAA5">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0FFFFFF">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#66FFFFFF">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#38FFFFFF">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush" Color="#407F77DD">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="HoverBrush" Color="#1F7F77DD">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="ActiveBrush" Color="#337F77DD">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="RunGreenBrush" Color="#5DCAA5">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="StopRedBrush" Color="#E5484D">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#0B0B10">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#131319">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0B0B10">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStops>
            <GradientStop Offset="0" Color="#387F77DD" />
            <GradientStop Offset="0.5" Color="#1C7F77DD" />
            <GradientStop Offset="1" Color="#007F77DD" />
        </GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#0E0E14">
        <SolidColorBrush.Transitions>
            <Transitions>
                <ColorTransition Property="Color" Duration="0:0:0.3" Easing="{StaticResource Motion.EaseInOut}" />
            </Transitions>
        </SolidColorBrush.Transitions>
    </SolidColorBrush>

</ResourceDictionary>
