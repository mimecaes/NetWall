<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NetWall.IDE.Controls"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit">

    <Style Selector="TextBlock.assistant-title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.assistant-label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.assistant-hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.assistant-option-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.assistant-errors">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource StopRedBrush}" />
    </Style>

    <Style Selector="Button.assistant-option">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.assistant-option:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed">
        <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Border.toolbar-pill">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="Button.toolbar-run">
    </Style>

    <Style Selector="Button.traffic-light">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.traffic-close">
        <Setter Property="Background" Value="#FF5F57" />
    </Style>
    <Style Selector="Button.traffic-minimize">
        <Setter Property="Background" Value="#FFBD2E" />
    </Style>
    <Style Selector="Button.traffic-maximize">
        <Setter Property="Background" Value="#28C840" />
    </Style>
    <Style Selector="Path.traffic-glyph">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="#4D2A00" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.traffic-lights:pointerover Path.traffic-glyph">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.tab-item">
        <Setter Property="Background" Value="{DynamicResource TabInactiveBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Border.tab-item.active">
        <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,2" />
    </Style>

    <Style Selector="Ellipse.dirty-indicator, TextBlock.saved-indicator">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.tab-item.closing">
        <Setter Property="Opacity" Value="1" />
        <Style.Animations>
            <Animation Duration="0:0:0.2" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Margin" Value="0,0,0,0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Margin" Value="-200,0,0,0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Button.tab-select">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.tab-item.active Button.tab-select">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.tab-close">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.tab-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="controls|AnimatedIcon.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeDashArray" Value="40,40" />
        <Setter Property="StrokeDashOffset" Value="0" />
    </Style>
    <Style Selector="controls|AnimatedIcon.icon-sm">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeDashArray" Value="40,40" />
        <Setter Property="StrokeDashOffset" Value="0" />
    </Style>

    <Style Selector="controls|AnimatedIcon.icon-lg">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="controls|AnimatedIcon.icon-md">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <Style Selector="Panel.welcome-logo">
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut" Delay="0:0:0.0">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="20" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="0" />
        </Setter>
    </Style>

    <Style Selector="TextBlock.welcome-title">
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut" Delay="0:0:0.06">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="20" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="0" />
        </Setter>
    </Style>

    <Style Selector="TextBlock.welcome-subtitle">
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut" Delay="0:0:0.12">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="20" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="0" />
        </Setter>
    </Style>

    <Style Selector="Button.welcome-button">
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut" Delay="0:0:0.18">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="20" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="0" />
        </Setter>
    </Style>

    <Style Selector="TextBlock.welcome-hint">
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut" Delay="0:0:0.24">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="StackPanel.welcome-recents">
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut" Delay="0:0:0.30">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="10" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
        <Setter Property="RenderTransform">
            <TranslateTransform Y="0" />
        </Setter>
    </Style>

    <Style Selector="Button.recent-project-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.recent-project-item">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource Motion.EaseOut}" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="{StaticResource Motion.EaseOut}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.recent-project-button:pointerover Border.recent-project-item">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>

    <Style Selector="TextBlock.welcome-feature">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A run of the active file: a thin bar on the left that turns green or red with the result. -->
    <Style Selector="Border.run-block">
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="Border.run-block.succeeded">
        <Setter Property="BorderBrush" Value="{DynamicResource RunGreenBrush}" />
    </Style>
    <Style Selector="Border.run-block.failed">
        <Setter Property="BorderBrush" Value="{DynamicResource StopRedBrush}" />
    </Style>

    <Style Selector="TextBlock.run-block-header">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.terminal-link:pointerover">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Button.welcome-cta">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="{StaticResource Motion.EaseOut}" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.welcome-cta:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="Button.welcome-cta:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <Style Selector="Button.toolbar-icon:pressed controls|AnimatedIcon.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.toolbar-icon controls|AnimatedIcon">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="{StaticResource Motion.EaseOut}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.toolbar-icon:pointerover controls|AnimatedIcon">
        <Setter Property="RenderTransform" Value="scale(1.3)" />
    </Style>

    <Style Selector="Border.save-all-badge">
        <Setter Property="Background" Value="#E5484D" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-5,-6,0" />
        <Setter Property="Padding" Value="3,0" />
    </Style>
    <Style Selector="TextBlock.save-all-badge-text">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.extensions-panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="-8" />
        </Setter>
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.18" FillMode="Forward" Easing="{StaticResource Motion.EaseOut}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="-8" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.extension-card-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RenderTransform">
            <TranslateTransform Y="0" />
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="{StaticResource Motion.EaseOut}" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.extension-card-item:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Border.extension-icon-tile">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.extension-search-border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.extension-search-input">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox.extension-search-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ToggleSwitch.extension-toggle">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="controls|PetWidget.pet-pop">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" />
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.4" FillMode="Forward" Easing="{StaticResource Motion.EaseOut}">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.X" Value="-40" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.X" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBlock.sidebar-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.status-text">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected TextBlock.tree-name">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected controls|AnimatedIcon.tree-icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.search-result-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.search-result-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBlock.search-result-path">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBox.terminal-input">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.terminal-output">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ToolTip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource TopBarBackgroundBrush}" />
    </Style>

    <Style Selector="ae|LineNumberMargin">
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

</Styles>
