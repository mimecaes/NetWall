<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NetWall.IDE.Controls"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit">

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed">
        <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- macOS-style traffic light window controls -->
    <Style Selector="Button.traffic-light">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.traffic-close">
        <Setter Property="Background" Value="#FF5F57" />
    </Style>
    <Style Selector="Button.traffic-minimize">
        <Setter Property="Background" Value="#FFBD2E" />
    </Style>
    <Style Selector="Button.traffic-maximize">
        <Setter Property="Background" Value="#28C840" />
    </Style>
    <Style Selector="Path.traffic-glyph">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="#4D2A00" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.traffic-lights:pointerover Path.traffic-glyph">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.tab-item">
        <Setter Property="Background" Value="{DynamicResource TabInactiveBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IdeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Border.tab-item.active">
        <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
    </Style>

    <Style Selector="Button.tab-select">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.tab-item.active Button.tab-select">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.tab-close">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.tab-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="controls|AnimatedIcon.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeDashArray" Value="40,40" />
        <Setter Property="StrokeDashOffset" Value="0" />
    </Style>
    <Style Selector="controls|AnimatedIcon.icon-sm">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeDashArray" Value="40,40" />
        <Setter Property="StrokeDashOffset" Value="0" />
    </Style>

    <Style Selector="controls|AnimatedIcon.icon-lg">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="controls|AnimatedIcon.icon-md">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- Welcome hero: slow continuous float on the big folder icon -->
    <Style Selector="Border.welcome-float">
        <Setter Property="RenderTransform">
            <TranslateTransform X="0" Y="0" />
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:2.2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="-10" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBlock.welcome-feature">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.welcome-cta">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.welcome-cta:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="Button.welcome-cta:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Hover "draw" reveal is driven from code (AnimatedIcon.cs) via PointerEntered/Exited
         on the ancestor Button, not a declarative :pointerover trigger, since Avalonia's
         Style.Animations did not reliably restart on repeated hover in/out. -->

    <!-- Click: line color flashes to the accent color while pressed -->
    <Style Selector="Button:pressed controls|AnimatedIcon.icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button:pressed controls|AnimatedIcon.icon-sm">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Main toolbar: macOS Dock-style smooth grow on hover -->
    <Style Selector="Button.toolbar-icon controls|AnimatedIcon">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.toolbar-icon:pointerover controls|AnimatedIcon">
        <Setter Property="RenderTransform" Value="scale(1.3)" />
    </Style>

    <Style Selector="TextBlock.sidebar-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.status-text">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <!-- No selection/hover overlay bar: only the file name and icon change color. -->
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:selected TextBlock.tree-name">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TreeViewItem:selected controls|AnimatedIcon.tree-icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.search-result-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.search-result-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBlock.search-result-path">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBox.terminal-input">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.terminal-output">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource IdeBorderBrush}" />
    </Style>
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    </Style>

    <Style Selector="ae|LineNumberMargin">
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

</Styles>
