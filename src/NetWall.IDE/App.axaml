<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetWall.IDE.App"
             xmlns:local="using:NetWall.IDE"
             RequestedThemeVariant="Dark">
             <!-- NetWall.IDE always runs in a VS Code-like dark chrome. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NetWall.IDE/Themes/MotionResources.axaml" />
                <ResourceInclude Source="avares://NetWall.IDE/Themes/BaseBrushes.axaml" />
                <ResourceInclude Source="avares://NetWall.IDE/Themes/Nebula.axaml" />
                <ResourceInclude Source="avares://NetWall.IDE/Themes/Dracula.axaml" />
                <ResourceInclude Source="avares://NetWall.IDE/Themes/Aurora.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://NetWall.IDE/Themes/IdeStyles.axaml" />
    </Application.Styles>
</Application>
