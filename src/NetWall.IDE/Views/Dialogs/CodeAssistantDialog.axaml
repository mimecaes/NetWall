<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetWall.IDE.ViewModels"
        x:Class="NetWall.IDE.Views.Dialogs.CodeAssistantDialog"
        x:DataType="vm:CodeAssistantViewModel"
        x:CompileBindings="True"
        Title="Asistente de código"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">

    <StackPanel Margin="20,18,20,16" Spacing="14">

        <StackPanel Spacing="10" IsVisible="{Binding IsChoosing}">
            <TextBlock Classes="assistant-title" Text="¿Qué quieres crear?" />
            <Button Classes="assistant-option" Command="{Binding ChooseRuleCommand}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="assistant-option-title" Text="Regla de firewall" />
                    <TextBlock Classes="assistant-hint" Text="Permite o bloquea tráfico según protocolo, puerto y direcciones" />
                </StackPanel>
            </Button>
            <Button Classes="assistant-option" Command="{Binding ChooseVariableCommand}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="assistant-option-title" Text="Variable" />
                    <TextBlock Classes="assistant-hint" Text="Declara un número, un texto o una red para usar en las reglas" />
                </StackPanel>
            </Button>
            <Button Classes="assistant-option" Command="{Binding ChoosePacketCommand}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="assistant-option-title" Text="Paquete para simular" />
                    <TextBlock Classes="assistant-hint" Text="Prueba qué decide el firewall con un paquete (va dentro de principal)" />
                </StackPanel>
            </Button>
            <Button Classes="assistant-option" Command="{Binding ChooseImportCommand}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="assistant-option-title" Text="Importación" />
                    <TextBlock Classes="assistant-hint" Text="Usa las variables y reglas de otro archivo del proyecto" />
                </StackPanel>
            </Button>
            <Button Classes="assistant-option" Command="{Binding ChooseMainCommand}">
                <StackPanel Spacing="2">
                    <TextBlock Classes="assistant-option-title" Text="Bloque principal" />
                    <TextBlock Classes="assistant-hint" Text="El punto de entrada del programa, con su política por defecto" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsRuleForm}">
            <TextBlock Classes="assistant-title" Text="Nueva regla" />
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Classes="assistant-label" Text="Nombre" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RuleName}" Watermark="web_oficina" />

                <TextBlock Grid.Row="1" Classes="assistant-label" Text="Acción" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:CodeAssistantViewModel.Actions}"
                          SelectedItem="{Binding Action}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2" Classes="assistant-label" Text="Protocolo" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:CodeAssistantViewModel.Protocols}"
                          SelectedItem="{Binding Protocol}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="3" Classes="assistant-label" Text="Puerto" VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton GroupName="Port" Content="ninguno" IsChecked="{Binding HasNoPort}" />
                        <RadioButton GroupName="Port" Content="número" IsChecked="{Binding HasSinglePort}" />
                        <RadioButton GroupName="Port" Content="rango" IsChecked="{Binding HasPortRange}" />
                    </StackPanel>
                    <TextBox Text="{Binding Port}" Watermark="80" IsVisible="{Binding HasSinglePort}" />
                    <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding HasPortRange}">
                        <TextBox Grid.Column="0" Text="{Binding PortFrom}" Watermark="1000" />
                        <TextBlock Grid.Column="1" Classes="assistant-hint" Text="hasta" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox Grid.Column="2" Text="{Binding PortTo}" Watermark="2000" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="4" Classes="assistant-label" Text="Origen" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Source}"
                         Watermark="vacío = cualquiera · ej. lan o 10.0.0.0/8" />

                <TextBlock Grid.Row="5" Classes="assistant-label" Text="Destino" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Destination}"
                         Watermark="vacío = cualquiera · ej. servidor o 10.0.0.5" />

                <TextBlock Grid.Row="6" Classes="assistant-label" Text="Comentario" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Comment}" Watermark="opcional" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsVariableForm}">
            <TextBlock Classes="assistant-title" Text="Nueva variable" />
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Classes="assistant-label" Text="Nombre" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VariableName}" Watermark="lan" />

                <TextBlock Grid.Row="1" Classes="assistant-label" Text="Tipo" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:CodeAssistantViewModel.Types}"
                          SelectedItem="{Binding VariableType}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2" Classes="assistant-label" Text="Valor" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VariableValue}"
                         Watermark="ej. 80, 2.5, servidor web o 192.168.1.0/24" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsPacketForm}">
            <TextBlock Classes="assistant-title" Text="Nuevo paquete para simular" />
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Classes="assistant-label" Text="Protocolo" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:CodeAssistantViewModel.PacketProtocols}"
                          SelectedItem="{Binding PacketProtocol}" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Classes="assistant-label" Text="Puerto" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PacketPort}" Watermark="80" />

                <TextBlock Grid.Row="2" Classes="assistant-label" Text="Origen" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PacketSource}" Watermark="ej. 10.0.0.5" />

                <TextBlock Grid.Row="3" Classes="assistant-label" Text="Destino" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PacketDestination}" Watermark="ej. servidor o 192.168.1.10" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsImportForm}">
            <TextBlock Classes="assistant-title" Text="Nueva importación" />
            <Grid ColumnDefinitions="96,*">
                <TextBlock Classes="assistant-label" Text="Archivo" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ImportFiles}" SelectedItem="{Binding SelectedImport}"
                          PlaceholderText="elige un archivo .nw" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Classes="assistant-hint" Text="La ruta se escribe relativa a la carpeta del archivo abierto." />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsMainForm}">
            <TextBlock Classes="assistant-title" Text="Nuevo bloque principal" />
            <Grid ColumnDefinitions="96,*">
                <TextBlock Classes="assistant-label" Text="Política" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CodeAssistantViewModel.Policies}"
                          SelectedItem="{Binding MainPolicy}" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Classes="assistant-hint" Text="Qué hacer con los paquetes que no coinciden con ninguna regla. Va al final del archivo." />
        </StackPanel>

        <TextBlock Classes="assistant-errors" Text="{Binding Errors}" IsVisible="{Binding HasErrors}" />

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Content="Atrás" Command="{Binding BackCommand}" IsVisible="{Binding !IsChoosing}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancelar" Click="OnCancelClick" />
                <Button Content="Insertar" Click="OnInsertClick" IsEnabled="{Binding CanInsert}"
                        IsVisible="{Binding !IsChoosing}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
