<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetWall.IDE.ViewModels"
        xmlns:models="using:NetWall.IDE.Models"
        xmlns:conv="using:NetWall.IDE.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="NetWall.IDE.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NetWall.IDE"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource EditorBackgroundBrush}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewFileCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Gesture="F5" Command="{Binding RunActiveFileCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New File" InputGesture="Ctrl+N" Command="{Binding NewFileCommand}" />
                <MenuItem Header="Open Folder..." InputGesture="Ctrl+O" Command="{Binding OpenFolderCommand}" />
                <Separator />
                <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}" />
                <MenuItem Header="Save All" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
                <Separator />
                <MenuItem Header="Close Tab" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle Sidebar" InputGesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
                <MenuItem Header="Toggle Terminal" Command="{Binding ToggleTerminalCommand}" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="Run Active File" InputGesture="F5" Command="{Binding RunActiveFileCommand}" />
            </MenuItem>
            <MenuItem Header="_Terminal">
                <MenuItem Header="Clear Terminal" Command="{Binding ClearTerminalCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource IdeBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="icon" Command="{Binding NewFileCommand}" ToolTip.Tip="New File (Ctrl+N)">
                    <Path Classes="icon" Data="{StaticResource IconNewFile}" />
                </Button>
                <Button Classes="icon" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open Folder (Ctrl+O)">
                    <Path Classes="icon" Data="{StaticResource IconFolder}" />
                </Button>
                <Button Classes="icon" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
                    <Path Classes="icon" Data="{StaticResource IconSave}" />
                </Button>
                <Button Classes="icon" Command="{Binding SaveAllCommand}" ToolTip.Tip="Save All (Ctrl+Shift+S)">
                    <Panel Width="16" Height="16">
                        <Path Classes="icon" Data="{StaticResource IconSave}" Width="13" Height="13" Margin="3,3,0,0" Opacity="0.5" />
                        <Path Classes="icon" Data="{StaticResource IconSave}" Width="13" Height="13" Margin="0,0,3,3" />
                    </Panel>
                </Button>

                <Rectangle Width="1" Margin="6,5" Fill="{DynamicResource IdeBorderBrush}" />

                <Button Classes="icon" Command="{Binding RunActiveFileCommand}" ToolTip.Tip="Run Active File (F5)">
                    <Path Data="{StaticResource IconRun}" Fill="{DynamicResource RunGreenBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Rectangle Width="1" Margin="6,5" Fill="{DynamicResource IdeBorderBrush}" />

                <Button Classes="icon" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle Sidebar (Ctrl+B)">
                    <Path Classes="icon" Data="{StaticResource IconSidebarToggle}" />
                </Button>
                <Button Classes="icon" Command="{Binding ToggleTerminalCommand}" ToolTip.Tip="Toggle Terminal">
                    <Path Classes="icon" Data="{StaticResource IconTerminal}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}" Height="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Classes="status-text" Text="{Binding RootName}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Classes="status-text" Text="{Binding SelectedTab.Language, FallbackValue=''}" />
                    <TextBlock Classes="status-text" Text="{Binding SelectedTab.Line, StringFormat='Ln {0}', FallbackValue=''}" />
                    <TextBlock Classes="status-text" Text="{Binding SelectedTab.Column, StringFormat='Col {0}', FallbackValue=''}" />
                    <TextBlock Classes="status-text" Text="UTF-8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid ColumnDefinitions="Auto,Auto,*">

            <!-- Sidebar: Explorer -->
            <Border Grid.Column="0" Width="260"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource IdeBorderBrush}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarVisible}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10,8,6">
                        <TextBlock Grid.Column="0" Classes="sidebar-header" Text="EXPLORER" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Width="22" Height="22" Command="{Binding NewFileCommand}" ToolTip.Tip="New File">
                            <Path Classes="icon-sm" Data="{StaticResource IconNewFile}" />
                        </Button>
                        <Button Grid.Column="2" Classes="icon" Width="22" Height="22" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open Folder">
                            <Path Classes="icon-sm" Data="{StaticResource IconRefresh}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Padding="12,4,12,8" IsVisible="{Binding IsFolderOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon-sm" Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{Binding RootName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <TreeView Background="Transparent"
                                  ItemsSource="{Binding RootNodes}"
                                  SelectionChanged="OnFileTreeSelectionChanged"
                                  IsVisible="{Binding IsFolderOpen}">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="models:FileTreeNode" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon-sm" Data="{Binding Converter={x:Static conv:NodeIconConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>

                        <StackPanel IsVisible="{Binding !IsFolderOpen}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="16">
                            <TextBlock Text="No folder opened" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                          IsVisible="{Binding IsSidebarVisible}" ResizeDirection="Columns" />

            <!-- Editor + Terminal -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">

                <Grid Grid.Row="0" RowDefinitions="Auto,*">

                    <!-- Tab strip -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Background="{DynamicResource TabInactiveBackgroundBrush}">
                        <ItemsControl ItemsSource="{Binding OpenTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EditorTabViewModel">
                                    <Border Classes="tab-item" Classes.active="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Path Classes="icon-sm" Data="{StaticResource IconFile}" />
                                            <Button Classes="tab-select"
                                                    Command="{Binding #Root.DataContext.SelectTabCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TextPrimaryBrush}"
                                                             IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="tab-close"
                                                    Command="{Binding #Root.DataContext.CloseTabCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Close">
                                                <Path Classes="icon-sm" Data="{StaticResource IconClose}" Width="10" Height="10" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Editor surface -->
                    <Grid Grid.Row="1">
                        <TextBox Classes="editor"
                                 Text="{Binding SelectedTab.Content, Mode=TwoWay}"
                                 CaretIndex="{Binding SelectedTab.CaretIndex, Mode=TwoWay}"
                                 IsVisible="{Binding SelectedTab, Converter={x:Static conv:NullToBoolConverter.IsNotNull}}" />

                        <StackPanel IsVisible="{Binding SelectedTab, Converter={x:Static conv:NullToBoolConverter.IsNull}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <TextBlock Text="NetWall.IDE" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a folder or create a new file to start editing"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Button Content="New File" Command="{Binding NewFileCommand}" />
                                <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Height="4" Background="Transparent"
                              IsVisible="{Binding IsTerminalVisible}" ResizeDirection="Rows" />

                <!-- Terminal panel -->
                <Border Grid.Row="2" Height="220"
                        Background="{DynamicResource TerminalBackgroundBrush}"
                        BorderBrush="{DynamicResource IdeBorderBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsTerminalVisible}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto"
                              Background="{DynamicResource PanelHeaderBackgroundBrush}" Height="30">
                            <TextBlock Grid.Column="0" Classes="sidebar-header" Text="TERMINAL"
                                       VerticalAlignment="Center" Margin="12,0" />
                            <Button Grid.Column="1" Classes="icon" Width="24" Height="24"
                                    Command="{Binding ClearTerminalCommand}" ToolTip.Tip="Clear Terminal">
                                <Path Classes="icon-sm" Data="{StaticResource IconRefresh}" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Width="24" Height="24" Margin="0,0,6,0"
                                    Command="{Binding ToggleTerminalCommand}" ToolTip.Tip="Close Panel">
                                <Path Classes="icon-sm" Data="{StaticResource IconClose}" />
                            </Button>
                        </Grid>

                        <Border DockPanel.Dock="Bottom"
                                BorderBrush="{DynamicResource IdeBorderBrush}" BorderThickness="0,1,0,0"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="$" Foreground="{DynamicResource RunGreenBrush}"
                                           FontFamily="Cascadia Code,Consolas,monospace" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Classes="terminal-input" Name="TerminalInputBox"
                                         Text="{Binding TerminalInput, Mode=TwoWay}"
                                         Watermark="Type a command and press Enter..."
                                         KeyDown="OnTerminalInputKeyDown" />
                            </Grid>
                        </Border>

                        <ScrollViewer Name="TerminalScrollViewer">
                            <TextBlock Classes="terminal-output" Text="{Binding TerminalOutput}" Margin="12,8" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
