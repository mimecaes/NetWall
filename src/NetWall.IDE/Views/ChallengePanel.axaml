<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetWall.IDE.ViewModels"
             xmlns:controls="using:NetWall.IDE.Controls"
             xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
             x:Class="NetWall.IDE.Views.ChallengePanel"
             x:DataType="vm:ChallengeViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="Border.notebook-cover">
            <Setter Property="Background" Value="{DynamicResource NotebookCoverBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 22 48 0 #88000000" />
        </Style>
        <Style Selector="Border.page">
            <Setter Property="Background" Value="{DynamicResource NotebookPageBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.page-arrow">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.page-arrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NotebookCoverBrush}" />
        </Style>
        <Style Selector="Button.page-arrow:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Button.page-arrow controls|AnimatedIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource NotebookInkBrush}" />
        </Style>
        <Style Selector="Path.page-corner">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Fill" Value="{DynamicResource NotebookBoxBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource NotebookLineBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Path.page-corner:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.35)" />
            <Setter Property="Fill" Value="{DynamicResource PastelLavenderBrush}" />
        </Style>
        <Style Selector="TextBlock.ink">
            <Setter Property="Foreground" Value="{DynamicResource NotebookInkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource NotebookMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="avares://NetWall.IDE/Assets/Fonts#Caveat" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Margin" Value="0,6,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookTitleBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource InkPinkBrush}" />
        </Style>
        <Style Selector="Border.type-badge">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.type-badge TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PastelInkBrush}" />
        </Style>
        <Style Selector="Border.lesson">
            <Setter Property="Margin" Value="0,22,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="16,16,16,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
        </Style>
        <Style Selector="controls|WashiTape.washi">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,-28,0,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="rotate(-4deg)" />
        </Style>
        <Style Selector="Border.post-it">
            <Setter Property="Width" Value="210" />
            <Setter Property="Margin" Value="40,0,0,18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="RenderTransform" Value="rotate(-3deg)" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.post-it.shown">
            <Setter Property="Opacity" Value="1" />
            <Style.Animations>
                <Animation Duration="0:0:0.15" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.post-it-top">
            <Setter Property="Background" Value="#FFF1A8" />
            <Setter Property="Padding" Value="14,0,14,4" />
            <Setter Property="BoxShadow" Value="1 3 6 0 #44000000" />
        </Style>
        <Style Selector="Border.post-it-glue">
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="-14,0,-14,7" />
            <Setter Property="Background" Value="#F4DE7A" />
        </Style>
        <Style Selector="Border.post-it-bottom">
            <Setter Property="Background" Value="#FFF1A8" />
            <Setter Property="Padding" Value="14,0,14,16" />
            <Setter Property="BoxShadow" Value="2 6 12 0 #55000000" />
        </Style>
        <Style Selector="Border.post-it.shown Border.post-it-bottom">
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.15" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.fold-shade">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="-14,0,-14,-16" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#66000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.post-it.shown Border.fold-shade">
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.15" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.code-box">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource NotebookCodeBrush}" />
        </Style>
        <Style Selector="Border.helpy-avatar">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
        </Style>
        <Style Selector="Border.helpy-bubble">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InkLavenderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.helpy-bubble.ok">
            <Setter Property="BorderBrush" Value="{DynamicResource InkMintBrush}" />
        </Style>
        <Style Selector="Border.helpy-bubble.no">
            <Setter Property="BorderBrush" Value="{DynamicResource InkPinkBrush}" />
        </Style>
        <Style Selector="Border.helpy-bubble TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookInkBrush}" />
        </Style>
        <Style Selector="Border.editor-box">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource NotebookCodeBrush}" />
            <Setter Property="BoxShadow" Value="2 8 18 0 #45000000" />
        </Style>
        <Style Selector="controls|WashiTape.corner-tape">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.test-chip">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.test-chip.passed">
            <Setter Property="BorderBrush" Value="{DynamicResource InkMintBrush}" />
        </Style>
        <Style Selector="Border.test-chip.failed">
            <Setter Property="BorderBrush" Value="{DynamicResource InkPinkBrush}" />
        </Style>
        <Style Selector="Border.test-chip TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookInkBrush}" />
        </Style>
        <Style Selector="Border.test-chip TextBlock.state">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookMutedBrush}" />
        </Style>
        <Style Selector="Border.test-chip.passed TextBlock.state">
            <Setter Property="Foreground" Value="{DynamicResource InkMintBrush}" />
        </Style>
        <Style Selector="Border.test-chip.failed TextBlock.state">
            <Setter Property="Foreground" Value="{DynamicResource InkPinkBrush}" />
        </Style>
        <Style Selector="Border.diagnostics">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InkMintBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
        </Style>
        <Style Selector="Border.diagnostics.warning">
            <Setter Property="BorderBrush" Value="{DynamicResource InkButterBrush}" />
        </Style>
        <Style Selector="Border.diagnostics.error">
            <Setter Property="BorderBrush" Value="{DynamicResource InkPinkBrush}" />
        </Style>
        <Style Selector="Border.diagnostics TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookMutedBrush}" />
        </Style>
        <Style Selector="Button.notebook-action">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NotebookBoxBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookInkBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.notebook-action:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>
        <Style Selector="Button.notebook-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NotebookBoxHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookInkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action controls|AnimatedIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource NotebookInkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action.mint, Button.notebook-action.pink">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PastelInkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action.mint">
            <Setter Property="Background" Value="{DynamicResource PastelMintBrush}" />
        </Style>
        <Style Selector="Button.notebook-action.pink">
            <Setter Property="Background" Value="{DynamicResource PastelPinkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action.mint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PastelMintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PastelInkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action.pink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PastelPinkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PastelInkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action.mint controls|AnimatedIcon">
            <Setter Property="Stroke" Value="{DynamicResource PastelInkBrush}" />
        </Style>
        <Style Selector="Button.notebook-action:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.question">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="4,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource NotebookInkBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,12,6,14">
            <Button Grid.Column="0" Classes="page-arrow" ToolTip.Tip="Página anterior (←)"
                    IsEnabled="{Binding CanGoBack}" Click="OnPreviousClick">
                <controls:AnimatedIcon Kind="ChevronLeft" />
            </Button>

            <Border Grid.Column="1" Name="Notebook" Classes="notebook-cover">
                <Grid ColumnDefinitions="*,28,1.3*">
                    <Border Grid.Column="0" Name="LeftPage" Classes="page">
                        <Panel>
                            <controls:NotebookPaper IsLeft="True" />
                            <DockPanel Margin="32,22,30,16">
                                <StackPanel DockPanel.Dock="Top">
                                    <Panel HorizontalAlignment="Left">
                                        <Border CornerRadius="10"
                                                Background="{Binding Current.Brush, FallbackValue={x:Null}}" />
                                        <TextBlock Margin="11,3" FontSize="11.5" FontWeight="SemiBold"
                                                   Text="{Binding ChapterText}"
                                                   Foreground="{DynamicResource PastelInkBrush}" />
                                    </Panel>
                                    <TextBlock Classes="page-title" Text="{Binding Current.Challenge.Title, FallbackValue=''}" />
                                    <Border Classes="type-badge" Background="{Binding TypeBrush}">
                                        <TextBlock Text="{Binding TypeLabel}" />
                                    </Border>
                                    <TextBlock Classes="ink" Text="{Binding TypeText}" />
                                    <TextBlock Classes="section" Text="Lo que vas a ver" />
                                    <ItemsControl ItemsSource="{Binding Learn}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                    <Ellipse Width="6" Height="6" Margin="2,6,10,0" VerticalAlignment="Top"
                                                             Fill="{DynamicResource PastelPinkBrush}" />
                                                    <TextBlock Grid.Column="1" Classes="ink" Text="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                                    <controls:WaxSeal Grid.Column="2" Name="Seal" Width="92" Height="92"
                                                      Level="{Binding Current.Seal, FallbackValue=0}" />
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Classes="lesson" IsVisible="{Binding HasLesson}">
                                        <StackPanel>
                                            <controls:WashiTape Classes="washi" Fill="{DynamicResource PastelLavenderBrush}" />
                                            <TextBlock FontSize="11" FontWeight="Bold" LetterSpacing="1"
                                                       Foreground="{DynamicResource InkLavenderBrush}" Text="MINI LECCIÓN" />
                                            <TextBlock Classes="ink" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,6"
                                                       Text="{Binding Current.Challenge.Lesson.Title, FallbackValue=''}" />
                                            <TextBlock Classes="ink" LineHeight="19"
                                                       Text="{Binding Current.Challenge.Lesson.Text, FallbackValue=''}" />
                                            <Border Classes="code-box"
                                                    IsVisible="{Binding Current.Challenge.Lesson.Example, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                                <controls:CodePreview Code="{Binding Current.Challenge.Lesson.Example, FallbackValue=''}"
                                                                      FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                                                      FontSize="12.5" Foreground="{DynamicResource NotebookCodeInkBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DockPanel>
                            <Border Classes="post-it" Classes.shown="{Binding HasHint}" IsVisible="{Binding HasHint}">
                                <StackPanel>
                                    <Border Classes="post-it-top">
                                        <StackPanel>
                                            <Border Classes="post-it-glue" />
                                            <TextBlock FontSize="11" FontWeight="Bold" LetterSpacing="1" Foreground="#8A6F12"
                                                       Text="PISTA DE HELPY" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="post-it-bottom" RenderTransformOrigin="50%,0%">
                                        <Border.RenderTransform>
                                            <ScaleTransform />
                                        </Border.RenderTransform>
                                        <Panel>
                                            <TextBlock FontSize="19" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#4F420C"
                                                       FontFamily="avares://NetWall.IDE/Assets/Fonts#Caveat"
                                                       Text="{Binding HintText}" />
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-16"
                                                  Data="M 18 0 L 18 18 L 0 18 Z" Fill="#E8D77E" />
                                            <Border Classes="fold-shade" />
                                        </Panel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Panel>
                    </Border>

                    <controls:NotebookSpine Grid.Column="1" />

                    <Border Grid.Column="2" Name="RightPage" Classes="page">
                        <Panel>
                            <controls:NotebookPaper />
                            <DockPanel Margin="44,20,24,16">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                                    <Border Classes="helpy-avatar">
                                        <controls:HelpySprite Name="Helpy" Width="40" Height="40" />
                                    </Border>
                                    <Border Grid.Column="1" Name="Bubble" Classes="helpy-bubble">
                                        <TextBlock Name="BubbleText" />
                                    </Border>
                                </Grid>

                                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0"
                                      IsVisible="{Binding IsPredict}">
                                    <Button Classes="notebook-action" Command="{Binding HintCommand}" ToolTip.Tip="Pídele una pista a Helpy">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <controls:AnimatedIcon Kind="Lightbulb" />
                                            <TextBlock Text="Pista" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Classes="question" Text="{Binding Question}" />
                                    <Button Grid.Column="2" Classes="notebook-action mint" Margin="0,0,8,0"
                                            Command="{Binding AnswerCommand}" CommandParameter="permitir" Content="✓ Pasa" />
                                    <Button Grid.Column="3" Classes="notebook-action pink" Command="{Binding AnswerCommand}"
                                            CommandParameter="bloquear" Content="✕ Se bloquea" />
                                </Grid>

                                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0"
                                      IsVisible="{Binding IsWriting}">
                                    <Button Classes="notebook-action" Command="{Binding HintCommand}" ToolTip.Tip="Pídele una pista a Helpy">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <controls:AnimatedIcon Kind="Lightbulb" />
                                            <TextBlock Text="Pista" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="notebook-action" Command="{Binding ResetCommand}"
                                            ToolTip.Tip="Volver al código del inicio">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <controls:AnimatedIcon Kind="RotateCcw" />
                                            <TextBlock Text="Reiniciar" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Classes="notebook-action mint" Command="{Binding CheckCommand}"
                                            ToolTip.Tip="Comprobar (Ctrl+Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <controls:AnimatedIcon Kind="Play" />
                                            <TextBlock Text="Comprobar" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border DockPanel.Dock="Bottom" Classes="diagnostics"
                                        Classes.warning="{Binding HasWarnings}" Classes.error="{Binding HasCodeErrors}"
                                        IsVisible="{Binding DiagnosticsText.Length}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DiagnosticsText}" />
                                        <TextBlock Text="{Binding DiagnosticsDetail}" IsVisible="{Binding HasDiagnosticsDetail}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <TextBlock FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,6"
                                               Foreground="{DynamicResource InkLavenderBrush}" Text="PRUEBAS" />
                                    <ItemsControl Name="TestList" ItemsSource="{Binding Tests}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChallengeTestCard">
                                                <Border Classes="test-chip" Classes.passed="{Binding IsPassed}"
                                                        Classes.failed="{Binding IsFailed}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Classes="state" Text="{Binding StateText}" />
                                                        <TextBlock Text="{Binding Title}" MaxWidth="220"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Panel Margin="0,16,0,0">
                                    <Border Classes="editor-box">
                                        <Border CornerRadius="6" ClipToBounds="True">
                                            <ae:TextEditor Name="Editor"
                                                           ShowLineNumbers="True"
                                                           WordWrap="False"
                                                           Background="{DynamicResource NotebookCodeBrush}"
                                                           Foreground="{DynamicResource NotebookCodeInkBrush}"
                                                           LineNumbersForeground="{DynamicResource NotebookCodeMutedBrush}"
                                                           FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                                           FontSize="14"
                                                           Padding="8,8" />
                                        </Border>
                                    </Border>
                                    <controls:WashiTape Classes="corner-tape" HorizontalAlignment="Left" Margin="-22,-6,0,0"
                                                        RenderTransform="rotate(-36deg)" Fill="{DynamicResource PastelPinkBrush}" />
                                    <controls:WashiTape Classes="corner-tape" HorizontalAlignment="Right" Margin="0,-6,-22,0"
                                                        RenderTransform="rotate(36deg)" Fill="{DynamicResource PastelSkyBrush}" />
                                </Panel>
                            </DockPanel>
                        </Panel>
                    </Border>
                    <controls:CorrectionLayer Grid.Column="2" Name="Correction" />
                    <Path Grid.Column="0" Classes="page-corner" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Data="M 0 0 L 26 26 L 0 26 Z" ToolTip.Tip="Página anterior"
                          IsVisible="{Binding CanGoBack}" PointerPressed="OnPreviousCornerPressed" />
                    <Path Grid.Column="2" Classes="page-corner" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Data="M 26 0 L 26 26 L 0 26 Z" ToolTip.Tip="Página siguiente"
                          IsVisible="{Binding CanGoForward}" PointerPressed="OnNextCornerPressed" />
                </Grid>
            </Border>
            <controls:PageTurn Grid.Column="1" Name="PageTurn" />

            <Button Grid.Column="2" Classes="page-arrow" ToolTip.Tip="Página siguiente (→)"
                    IsEnabled="{Binding CanGoForward}" Click="OnNextClick">
                <controls:AnimatedIcon Kind="ChevronRight" />
            </Button>
        </Grid>

    </Panel>
</UserControl>
