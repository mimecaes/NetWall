<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetWall.IDE.ViewModels"
             xmlns:controls="using:NetWall.IDE.Controls"
             xmlns:models="using:NetWall.IDE.Models"
             x:Class="NetWall.IDE.Views.ClassPanel"
             x:DataType="vm:ClassViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector=":is(Control).class-view">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(12px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Control).class-view.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector=":is(Control).swap">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Control).swap.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.class-primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.class-primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="Button.class-primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.class-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.class-secondary">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.class-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.class-secondary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.class-icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.class-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.class-icon.danger:pointerover controls|AnimatedIcon">
            <Setter Property="Stroke" Value="{DynamicResource StopRedBrush}" />
        </Style>
        <Style Selector="Border.exercise-card">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.32" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.exercise-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="RenderTransform" Value="translateX(3px)" />
        </Style>
        <Style Selector="Border.exercise-card.selected">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.exercise-card.dragging">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Border.exercise-card controls|AnimatedIcon.type">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="StackPanel.card-tools">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.exercise-card:pointerover StackPanel.card-tools, Border.exercise-card.selected StackPanel.card-tools">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.grip">
            <Setter Property="Width" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="TextBox.title-field">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.title-field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.title-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Border.test-card">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.test-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.expect">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.expect.allow:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RunGreenBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.expect.block:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StopRedBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.class-notice">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,28" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StopRedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 22 0 #66000000" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(14px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.class-notice.ok">
            <Setter Property="BorderBrush" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Border.class-notice.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Border.check-badge">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(0.4)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.check-badge.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Border.test-card.passed">
            <Setter Property="BorderBrush" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Border.test-card.failed">
            <Setter Property="BorderBrush" Value="{DynamicResource StopRedBrush}" />
        </Style>
        <Style Selector="Border.solution-result">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StopRedBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.solution-result.passed">
            <Setter Property="BorderBrush" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Border.solution-result.testing">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Border.room-code">
            <Setter Property="Padding" Value="28,10" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector=":is(Control).shown Ellipse.live">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.firewall-box">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.cable">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cable.on">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.lab-seat">
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="5,0,5,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.35" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.lab-seat.on">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Border.lab-seat.on:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Border.lab-seat.away">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Border.lab-seat controls|KittenAvatar.seat-kitten">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%,100%" />
            <Setter Property="RenderTransform" Value="scale(0.3)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.lab-seat.on controls|KittenAvatar.seat-kitten">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Border.monitor">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.5" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.5" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.lab-seat.on Border.monitor">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="StackPanel.screen-lines">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.screen-lines Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
        <Style Selector="Border.lab-seat.on StackPanel.screen-lines">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Border.lab-seat.away StackPanel.screen-lines">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Ellipse.answered">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(0.2)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.answered.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Border.packet-card">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ProgressBar.countdown">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
        </Style>
        <Style Selector="controls|KittenAvatar.voter">
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="RenderTransformOrigin" Value="50%,100%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="controls|KittenAvatar.voter.voted">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1.15)" />
        </Style>
        <Style Selector="Border.vote-bar">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.8" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.vote-bar.correct">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.podium-step">
            <Setter Property="CornerRadius" Value="10,10,0,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.7" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.vote-button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="64" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.vote-button.allow">
            <Setter Property="Background" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Button.vote-button.block">
            <Setter Property="Background" Value="{DynamicResource StopRedBrush}" />
        </Style>
        <Style Selector="Button.vote-button.allow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Button.vote-button.block:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StopRedBrush}" />
        </Style>
        <Style Selector="Button.vote-button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.vote-button.chosen">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>
        <Style Selector="Button.vote-button.faded">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="Border.reveal-card">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StopRedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.reveal-card.correct">
            <Setter Property="BorderBrush" Value="{DynamicResource RunGreenBrush}" />
        </Style>
        <Style Selector="Border.avatar-preview">
            <Setter Property="CornerRadius" Value="46" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.avatar-choice">
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.avatar-choice:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>
        <Style Selector="Button.avatar-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.avatar-choice.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.room-card">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Animations>
                <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.room-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Grid.shake-host.shake">
            <Style.Animations>
                <Animation Duration="0:0:0.4">
                    <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="20%">
                        <Setter Property="Margin" Value="-10,0,10,0" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="Margin" Value="8,0,-8,0" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Margin" Value="-6,0,6,0" />
                    </KeyFrame>
                    <KeyFrame Cue="80%">
                        <Setter Property="Margin" Value="3,0,-3,0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.dirty">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.dirty.shown">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <StackPanel Classes="class-view" Classes.shown="{Binding IsLanding}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
            <TextBlock Text="Modo Clase" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Lleva tus ejercicios al laboratorio de redes" FontSize="14" HorizontalAlignment="Center"
                       Margin="0,6,0,26" Foreground="{DynamicResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Classes="class-primary" Click="OnNewClassClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Kind="Plus" Width="16" Height="16" Stretch="Uniform" Stroke="White"
                                               StrokeThickness="2" />
                        <TextBlock Text="Nueva clase" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
                <Button Classes="class-secondary" Click="OnOpenClassClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="FolderOpen" />
                        <TextBlock Text="Abrir clase" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="¿Eres estudiante?" FontSize="12.5" HorizontalAlignment="Center" Margin="0,30,0,8"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Button Classes="class-secondary" HorizontalAlignment="Center" Click="OnJoinClassClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:AnimatedIcon Classes="icon-sm" Kind="LogIn" />
                    <TextBlock Text="Unirme a una clase" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DockPanel Classes="class-view" Classes.shown="{Binding IsHosting}" Margin="30,18,30,16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button Classes="class-primary" IsEnabled="{Binding Room.HasVoteExercises}"
                        ToolTip.Tip="Inicia una pregunta de ¿Pasa o se bloquea? para todos">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Kind="Vote" Width="15" Height="15" Stretch="Uniform" Stroke="White" StrokeThickness="2" />
                        <TextBlock Text="Iniciar votación" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <ItemsControl ItemsSource="{Binding Room.VoteExercises}" MinWidth="260">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ClassExercise">
                                        <Button Classes="room-card" Content="{Binding Title}" Click="OnVoteChosen" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="class-secondary" Click="OnCloseRoomClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="DoorClosed" />
                        <TextBlock Text="Cerrar sala" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                <StackPanel Width="780">
                    <Border Classes="firewall-box" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                            <controls:AnimatedIcon Grid.RowSpan="2" Classes="icon" Kind="BrickWall"
                                                   Stroke="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Room.ClassName}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="7" Margin="0,3,0,0">
                                <Ellipse Classes="live" Width="8" Height="8" Fill="{DynamicResource RunGreenBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Room.ConnectedText}" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Grid.RowSpan="2" Classes="room-code" Margin="22,0,0,0" Padding="16,6"
                                    VerticalAlignment="Center" ToolTip.Tip="Código de la sala">
                                <TextBlock Text="{Binding Room.Code}" FontSize="24" FontWeight="Bold" LetterSpacing="4"
                                           FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Width="2" Height="16" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}"
                            Opacity="0.5" />
                    <Border Height="2" Margin="62,0" Background="{DynamicResource AccentBrush}" Opacity="0.35" />
                    <ItemsControl ItemsSource="{Binding Room.Seats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LabSeat">
                                <StackPanel>
                                    <Border Classes="cable" Classes.on="{Binding IsConnected}" Width="2" Height="10"
                                            HorizontalAlignment="Center" />
                                    <Border Classes="lab-seat" Classes.on="{Binding IsOccupied}" Classes.away="{Binding IsAway}">
                                        <ToolTip.Tip>
                                            <StackPanel Spacing="3" MinWidth="150">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:KittenAvatar Width="34" Height="34" Color="{Binding Color}"
                                                                           Accessory="{Binding Accessory}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Number, StringFormat='Puesto {0}'}" FontSize="11.5" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Address}" FontSize="11.5"
                                                           FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11.5" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Grid RowDefinitions="*,Auto,Auto">
                                            <Grid ColumnDefinitions="*,Auto" Margin="8,6,8,0">
                                                <Panel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                    <controls:KittenAvatar Classes="seat-kitten" Width="38" Height="38"
                                                                           Color="{Binding Color}" Accessory="{Binding Accessory}" />
                                                    <Ellipse Classes="answered" Classes.shown="{Binding HasAnswered}" Width="10" Height="10"
                                                             Fill="{DynamicResource RunGreenBrush}" Stroke="{DynamicResource PanelBackgroundBrush}"
                                                             StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Panel>
                                                <Border Grid.Column="1" Classes="monitor" Width="42" Height="28"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Classes="screen-lines" Margin="6,6,0,0" Spacing="3">
                                                        <Border Width="22" Height="2" HorizontalAlignment="Left" />
                                                        <Border Width="15" Height="2" HorizontalAlignment="Left" />
                                                        <Border Width="19" Height="2" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="11.5" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="6,2,6,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Row="2" Text="{Binding Address}" FontSize="9.5" HorizontalAlignment="Center"
                                                       Margin="0,0,0,5" FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Viewbox>
        </DockPanel>

        <Border Classes="class-view vote-stage" Classes.shown="{Binding Room.IsVoting}" Background="{DynamicResource BackgroundBrush}">
            <Grid Margin="36,22" RowDefinitions="Auto,*,Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="Vote" Stroke="{DynamicResource AccentBrush}" />
                        <TextBlock Text="¿Pasa o se bloquea?" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Room.VoteExercise.Title, FallbackValue=''}" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Room.VoteExercise.Statement, FallbackValue=''}" FontSize="14"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,24,400" Margin="0,16,0,0">
                    <Border CornerRadius="10" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <controls:CodeBox Code="{Binding Room.VoteExercise.Starter, FallbackValue=''}" IsReadOnly="True"
                                          ShowLineNumbers="True" Background="{DynamicResource EditorBackgroundBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          LineNumbersForeground="{DynamicResource TextDisabledBrush}"
                                          FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" FontSize="15" Padding="8" />
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Classes="packet-card">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:AnimatedIcon Classes="icon-sm" Kind="Send" Stroke="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Paquete" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Room.PacketText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                           FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Panel Margin="0,18,0,0">
                            <StackPanel Classes="swap" Classes.shown="{Binding !Room.IsRevealed}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Room.AnsweredText}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Room.RemainingText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <ProgressBar Classes="countdown" Minimum="0" Maximum="1" Value="{Binding Room.Remaining}" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding Room.Seats}" Margin="0,16,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LabSeat">
                                            <controls:KittenAvatar Classes="voter" Classes.voted="{Binding HasVoted}" Width="30" Height="30"
                                                                   IsVisible="{Binding IsConnected}" Color="{Binding Color}"
                                                                   Accessory="{Binding Accessory}" ToolTip.Tip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Classes="swap" Classes.shown="{Binding Room.IsRevealed}" Spacing="10">
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Text="Pasa" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Border Classes="vote-bar" Classes.correct="{Binding Room.CorrectIsAllow}"
                                                Width="{Binding Room.AllowWidth}" Background="{DynamicResource RunGreenBrush}" />
                                        <TextBlock Text="{Binding Room.AllowCount}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Text="Se bloquea" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Border Classes="vote-bar" Classes.correct="{Binding !Room.CorrectIsAllow}"
                                                Width="{Binding Room.BlockWidth}" Background="{DynamicResource StopRedBrush}" />
                                        <TextBlock Text="{Binding Room.BlockCount}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="packet-card" Margin="0,8,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource RunGreenBrush}"
                                                   IsVisible="{Binding Room.CorrectIsAllow}" Text="Respuesta correcta: pasa" />
                                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource StopRedBrush}"
                                                   IsVisible="{Binding !Room.CorrectIsAllow}" Text="Respuesta correcta: se bloquea" />
                                        <TextBlock Text="{Binding Room.RuleText}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Panel>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Classes="class-view podium" Classes.shown="{Binding Room.IsPodium}"
                        Background="{DynamicResource BackgroundBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Podio" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Nadie sumó puntos todavía." FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   IsVisible="{Binding !Room.Podium.Count}" Foreground="{DynamicResource TextMutedBrush}" />
                        <ItemsControl ItemsSource="{Binding Room.Podium}" Margin="0,20,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="18" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PodiumPlace">
                                    <StackPanel Width="150" VerticalAlignment="Bottom">
                                        <controls:KittenAvatar Width="76" Height="76" HorizontalAlignment="Center"
                                                               Color="{Binding Color}" Accessory="{Binding Accessory}" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding PointsText}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,6"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Border Classes="podium-step" Height="{Binding Height}">
                                            <TextBlock Text="{Binding Rank}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Classes="class-primary" Content="Revelar ahora" IsVisible="{Binding !Room.IsRevealed}"
                            Command="{Binding Room.RevealCommand}" />
                    <Button Classes="class-primary" IsVisible="{Binding Room.IsRevealed}" Command="{Binding Room.ShowPodiumCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AnimatedIcon Kind="Trophy" Width="15" Height="15" Stretch="Uniform" Stroke="White" StrokeThickness="2" />
                            <TextBlock Text="Ver podio" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button Classes="class-secondary" Command="{Binding Room.CloseVoteCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AnimatedIcon Classes="icon-sm" Kind="Monitor" />
                            <TextBlock Text="Volver al laboratorio" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Classes="class-view" Classes.shown="{Binding IsJoining}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Width="440">
            <TextBlock Text="Unirme a una clase" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Grid ColumnDefinitions="Auto,*" Margin="0,22,0,0">
                <Border Classes="avatar-preview" Width="92" Height="92" Margin="0,0,16,0">
                    <controls:KittenAvatar Width="76" Height="76" Color="{Binding Join.Color}" Accessory="{Binding Join.Accessory}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Tu nombre" Margin="0,0,0,6" />
                    <TextBox Classes="field" Text="{Binding Join.Name}" MaxLength="24" Watermark="Como te verá el profesor" />
                </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="Tu gatito" />
            <ItemsControl ItemsSource="{Binding Join.Colors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AvatarChoice">
                        <Button Classes="avatar-choice" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:ClassViewModel)DataContext).Join.PickColorCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}">
                            <controls:KittenAvatar Width="34" Height="34" Color="{Binding Color}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Join.Accessories}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AvatarChoice">
                        <Button Classes="avatar-choice" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Label}"
                                Command="{Binding $parent[ItemsControl].((vm:ClassViewModel)DataContext).Join.PickAccessoryCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}">
                            <controls:KittenAvatar Width="34" Height="34"
                                                   Color="{Binding $parent[ItemsControl].((vm:ClassViewModel)DataContext).Join.Color, FallbackValue=Gray}"
                                                   Accessory="{Binding Accessory}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="label" Text="Salas en esta red" />
            <Border Classes="searching" IsVisible="{Binding !Join.HasRooms}" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource SurfaceBackgroundBrush}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Ellipse Classes="live" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Buscando salas abiertas…" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Join.Rooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FoundRoom">
                        <Button Classes="room-card" Command="{Binding $parent[ItemsControl].((vm:ClassViewModel)DataContext).Join.JoinRoomCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <controls:AnimatedIcon Classes="icon-sm" Kind="Presentation" Stroke="{DynamicResource AccentBrush}"
                                                       Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ClassName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StudentsText}" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Entrar" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="label" Text="O escribe el código que muestra el profesor" />
            <Grid ColumnDefinitions="*,Auto" Name="CodeBoxShell" Classes="shake-host">
                <TextBox Classes="field" Text="{Binding Join.Code}" MaxLength="9" Watermark="K7M2-QX4"
                         FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" FontSize="16" />
                <Button Grid.Column="1" Classes="class-primary" Margin="8,0,0,0" Command="{Binding Join.JoinCodeCommand}"
                        IsEnabled="{Binding Join.CanJoin}">
                    <TextBlock Text="Unirme" FontWeight="SemiBold" Foreground="White" />
                </Button>
            </Grid>
            <Button Classes="class-icon" Width="NaN" Padding="10,0" Margin="0,22,0,0" HorizontalAlignment="Center"
                    Click="OnBackClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:AnimatedIcon Classes="icon-sm" Kind="ArrowLeft" />
                    <TextBlock Text="Volver" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DockPanel Classes="class-view" Classes.shown="{Binding IsStudent}" Margin="30,20,30,16">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <Border Classes="avatar-preview" Width="58" Height="58" CornerRadius="29" Margin="0,0,14,0">
                    <controls:KittenAvatar Width="46" Height="46" Color="{Binding Join.Color}" Accessory="{Binding Join.Accessory}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Join.ClassName}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                        <Ellipse Classes="live" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource RunGreenBrush}" IsVisible="{Binding !Join.IsReconnecting}" />
                        <Ellipse Classes="live" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource StopRedBrush}" IsVisible="{Binding Join.IsReconnecting}" />
                        <TextBlock Text="{Binding Join.SeatText}" FontSize="12.5" IsVisible="{Binding !Join.IsReconnecting}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="Se cortó la conexión. Reconectando…" FontSize="12.5"
                                   IsVisible="{Binding Join.IsReconnecting}" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="class-secondary" VerticalAlignment="Center" Click="OnBackClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="LogOut" />
                        <TextBlock Text="Salir de la clase" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid ColumnDefinitions="270,22,*">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Join.Exercises}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentExercise">
                                <Border Classes="exercise-card" Classes.selected="{Binding IsSelected}" Padding="10,10"
                                        PointerPressed="OnStudentCardPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <controls:AnimatedIcon Classes="type" Kind="{Binding Icon}" Margin="2,0,10,0"
                                                               VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding Number}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Exercise.Title}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="check-badge" Classes.shown="{Binding IsSolved}"
                                                Background="{DynamicResource RunGreenBrush}">
                                            <controls:AnimatedIcon Classes="icon-sm" Kind="Check" Stroke="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TransitioningContentControl Grid.Column="2" Content="{Binding Join.Selected}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.22" />
                    </TransitioningContentControl.PageTransition>
                    <TransitioningContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:StudentExercise">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:AnimatedIcon Classes="icon-sm" Kind="{Binding Icon}" Stroke="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Exercise.Title}" FontSize="20" FontWeight="Bold" Margin="0,8,0,4"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Exercise.Statement}" FontSize="13.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border IsVisible="{Binding IsVote}" Margin="0,16,0,0" Padding="14,11" CornerRadius="8"
                                            Background="{DynamicResource SurfaceBackgroundBrush}">
                                        <TextBlock Text="Este ejercicio se responde todos juntos cuando el profesor inicie la votación."
                                                   FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                    <StackPanel IsVisible="{Binding IsWritable}">
                                        <TextBlock Classes="label" Text="Tu código" />
                                        <Border CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <controls:CodeBox Code="{Binding Code}" Height="230" ShowLineNumbers="True"
                                                              Background="{DynamicResource EditorBackgroundBrush}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              LineNumbersForeground="{DynamicResource TextDisabledBrush}"
                                                              FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                                              FontSize="13.5" Padding="6" />
                                        </Border>
                                        <TextBlock Classes="label" Text="Pruebas" />
                                        <ItemsControl ItemsSource="{Binding Tests}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StudentTest">
                                                    <Border Classes="test-card" Classes.passed="{Binding IsPassed}"
                                                            Classes.failed="{Binding IsFailed}" Padding="12,8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Test.Label}" FontSize="12.5" VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Panel Grid.Column="1">
                                                                <Border Classes="check-badge" Classes.shown="{Binding IsPassed}"
                                                                        Background="{DynamicResource RunGreenBrush}">
                                                                    <controls:AnimatedIcon Classes="icon-sm" Kind="Check" Stroke="White"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Classes="check-badge" Classes.shown="{Binding IsFailed}"
                                                                        Background="{DynamicResource StopRedBrush}">
                                                                    <controls:AnimatedIcon Classes="icon-sm" Kind="X" Stroke="White"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Panel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="class-primary" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Command="{Binding SubmitCommand}" IsEnabled="{Binding CanCheck}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:AnimatedIcon Kind="Send" Width="14" Height="14" Stretch="Uniform"
                                                                       Stroke="White" StrokeThickness="2" />
                                                <TextBlock Text="Comprobar y enviar" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Border Classes="solution-result swap" Classes.shown="{Binding HasResult}"
                                                Classes.passed="{Binding ResultPassed}" Classes.testing="{Binding IsChecking}"
                                                Margin="0,10,0,24">
                                            <TextBlock Text="{Binding ResultText}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TransitioningContentControl.ContentTemplate>
                </TransitioningContentControl>
            </Grid>
        </DockPanel>

        <Border Classes="class-view vote-stage" Classes.shown="{Binding Join.IsVoting}" Background="{DynamicResource BackgroundBrush}">
            <Grid Margin="36,22" RowDefinitions="Auto,Auto,*">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="Vote" Stroke="{DynamicResource AccentBrush}" />
                        <TextBlock Text="¿Pasa o se bloquea?" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Join.VoteExercise.Exercise.Title, FallbackValue=''}" FontSize="24" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Join.VoteExercise.Exercise.Statement, FallbackValue=''}" FontSize="13.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <ProgressBar Grid.Row="1" Classes="countdown" Minimum="0" Maximum="1" Value="{Binding Join.VoteRemaining}"
                             Margin="0,12,0,14" />
                <Grid Grid.Row="2" ColumnDefinitions="*,24,380">
                    <Border CornerRadius="10" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <controls:CodeBox Code="{Binding Join.VoteExercise.Code, FallbackValue=''}" IsReadOnly="True"
                                          ShowLineNumbers="True" Background="{DynamicResource EditorBackgroundBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          LineNumbersForeground="{DynamicResource TextDisabledBrush}"
                                          FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace" FontSize="14" Padding="8" />
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Classes="packet-card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Paquete" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Join.VotePacket}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                           FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Panel Margin="0,18,0,0">
                            <StackPanel Classes="swap" Classes.shown="{Binding !Join.IsRevealed}" Spacing="10">
                                <Button Classes="vote-button allow" Classes.chosen="{Binding Join.ChoseAllow}"
                                        Classes.faded="{Binding Join.ChoseBlock}" Command="{Binding Join.VoteCommand}"
                                        CommandParameter="permitir">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <controls:AnimatedIcon Kind="Check" Width="20" Height="20" Stretch="Uniform" Stroke="White"
                                                               StrokeThickness="2.5" />
                                        <TextBlock Text="Pasa" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="vote-button block" Classes.chosen="{Binding Join.ChoseBlock}"
                                        Classes.faded="{Binding Join.ChoseAllow}" Command="{Binding Join.VoteCommand}"
                                        CommandParameter="bloquear">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <controls:AnimatedIcon Kind="X" Width="20" Height="20" Stretch="Uniform" Stroke="White"
                                                               StrokeThickness="2.5" />
                                        <TextBlock Text="Se bloquea" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Respuesta enviada. Espera a que el profesor revele el resultado." FontSize="12.5"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" IsVisible="{Binding Join.HasVoted}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Border Classes="swap reveal-card" Classes.shown="{Binding Join.IsRevealed}"
                                    Classes.correct="{Binding Join.VoteCorrect}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Join.RevealTitle}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Join.RevealText}" FontSize="13.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Join.PointsText}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                        </Panel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Classes="class-view" Classes.shown="{Binding IsEditing}" Margin="36,26,36,20">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
                <Button Classes="class-secondary" VerticalAlignment="Top" Margin="0,2,14,0" Click="OnEditorBackClick"
                        ToolTip.Tip="Volver al inicio de Modo Clase">
                    <controls:AnimatedIcon Classes="icon-sm" Kind="ArrowLeft" />
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBox Classes="title-field" Text="{Binding Name}" Watermark="Nombre de la clase" />
                    <TextBox Classes="title-field" FontSize="13" FontWeight="Normal" Margin="0,4,0,0"
                             Text="{Binding Description}" Watermark="Descripción (opcional)"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Classes="class-secondary" Click="OnNewClassClick" ToolTip.Tip="Nueva clase">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="Plus" />
                    </Button>
                    <Button Classes="class-secondary" Click="OnOpenClassClick" ToolTip.Tip="Abrir clase">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="FolderOpen" />
                    </Button>
                    <Button Classes="class-secondary" Click="OnOpenRoomClick" ToolTip.Tip="Abrir la sala para los estudiantes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AnimatedIcon Classes="icon-sm" Kind="Radio" Stroke="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Abrir sala" />
                        </StackPanel>
                    </Button>
                    <Button Classes="class-primary" Click="OnSaveClick" ToolTip.Tip="Guardar (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AnimatedIcon Kind="Save" Width="15" Height="15" Stretch="Uniform" Stroke="White"
                                                   StrokeThickness="2" />
                            <TextBlock Text="Guardar" FontWeight="SemiBold" Foreground="White" />
                            <Ellipse Classes="dirty" Classes.shown="{Binding IsDirty}" Width="7" Height="7" Fill="White"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Classes="class-view" Classes.shown="{Binding IsConfirmingDiscard}"
                    IsVisible="{Binding IsConfirmingDiscard}" Margin="0,0,0,14" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource StopRedBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="Tienes cambios sin guardar. ¿Quieres descartarlos?" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Grid.Column="1" Classes="class-secondary" Margin="0,0,8,0" Content="Cancelar"
                            Command="{Binding CancelDiscardCommand}" />
                    <Button Grid.Column="2" Classes="class-primary" Content="Descartar"
                            Command="{Binding ConfirmDiscardCommand}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="300,24,*">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Classes="class-secondary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AnimatedIcon Classes="icon-sm" Kind="Plus" />
                            <TextBlock Text="Agregar ejercicio" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuItem Header="Reto libre" Command="{Binding AddExerciseCommand}" CommandParameter="free" />
                                <MenuItem Header="¿Pasa o se bloquea?" Command="{Binding AddExerciseCommand}"
                                          CommandParameter="predict" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock DockPanel.Dock="Top" Classes="label" Margin="2,0,0,8" Text="{Binding ExerciseCountText}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="ExerciseList" ItemsSource="{Binding Exercises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciseEditor">
                                    <Border Classes="exercise-card" Classes.selected="{Binding IsSelected}"
                                            Classes.dragging="{Binding IsDragging}" PointerPressed="OnCardPressed">
                                        <Panel>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,10,8,10"
                                                  Classes="swap" Classes.shown="{Binding !IsConfirmingDelete}">
                                                <Border Classes="grip" PointerPressed="OnGripPressed"
                                                        PointerMoved="OnGripMoved" PointerReleased="OnGripReleased"
                                                        ToolTip.Tip="Arrastra para ordenar">
                                                    <controls:AnimatedIcon Classes="icon-sm" Kind="GripVertical" />
                                                </Border>
                                                <controls:AnimatedIcon Grid.Column="1" Classes="type" Kind="{Binding Icon}"
                                                                       Margin="6,0,10,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <Run Text="{Binding Number}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding DisplayTitle}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="{Binding TypeText}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding TestsText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Classes="card-tools" Orientation="Horizontal">
                                                    <Button Classes="class-icon" ToolTip.Tip="Duplicar"
                                                            Command="{Binding DuplicateCommand}">
                                                        <controls:AnimatedIcon Classes="icon-sm" Kind="Copy" />
                                                    </Button>
                                                    <Button Classes="class-icon danger" ToolTip.Tip="Borrar"
                                                            Command="{Binding AskDeleteCommand}">
                                                        <controls:AnimatedIcon Classes="icon-sm" Kind="Trash2" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,8" Classes="swap"
                                                  Classes.shown="{Binding IsConfirmingDelete}">
                                                <TextBlock Text="¿Borrar este ejercicio?" VerticalAlignment="Center"
                                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Button Grid.Column="1" Classes="class-secondary" Padding="10,5" Margin="0,0,6,0"
                                                        Content="No" Command="{Binding CancelDeleteCommand}" />
                                                <Button Grid.Column="2" Classes="class-primary" Padding="10,5"
                                                        Background="{DynamicResource StopRedBrush}" Content="Borrar"
                                                        Command="{Binding DeleteCommand}" />
                                            </Grid>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <TransitioningContentControl Grid.Column="2" Content="{Binding Selected}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.22" />
                    </TransitioningContentControl.PageTransition>
                    <TransitioningContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ExerciseEditor">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:AnimatedIcon Classes="icon-sm" Kind="{Binding Icon}"
                                                               Stroke="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <TextBlock Classes="label" Text="Título" />
                                    <TextBox Classes="field" Text="{Binding Title}" Watermark="Ej.: Permite la web" />
                                    <TextBlock Classes="label" Text="Enunciado" />
                                    <TextBox Classes="field" Text="{Binding Statement}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="70"
                                             Watermark="Lo que verán los estudiantes" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="label" Text="{Binding StarterText}" />
                                        <Button Grid.Column="1" Classes="class-icon" Width="NaN" Padding="8,0"
                                                VerticalAlignment="Bottom" Margin="0,0,0,4" Click="OnUseNwClick"
                                                ToolTip.Tip="Copiar el código de un archivo .nw">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:AnimatedIcon Classes="icon-sm" Kind="FileCode" />
                                                <TextBlock Text="Usar un .nw" FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}">
                                        <controls:CodeBox Code="{Binding Starter}" Height="170" ShowLineNumbers="True"
                                                          Background="{DynamicResource EditorBackgroundBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          LineNumbersForeground="{DynamicResource TextDisabledBrush}"
                                                          FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                                          FontSize="13" Padding="6" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="label" Text="Pruebas" />
                                        <Button Grid.Column="1" Classes="class-icon" Width="NaN" Padding="8,0"
                                                VerticalAlignment="Bottom" Margin="0,0,0,4" IsVisible="{Binding CanAddTests}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:AnimatedIcon Classes="icon-sm" Kind="Plus" />
                                                <TextBlock Text="Agregar prueba" FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Paquete" Command="{Binding AddTestCommand}" CommandParameter="packet" />
                                                    <MenuItem Header="Política por defecto" Command="{Binding AddTestCommand}"
                                                              CommandParameter="policy" />
                                                    <MenuItem Header="Variable" Command="{Binding AddTestCommand}"
                                                              CommandParameter="variable" />
                                                    <MenuItem Header="Sin advertencias" Command="{Binding AddTestCommand}"
                                                              CommandParameter="clean" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Border IsVisible="{Binding IsPredict}" Margin="0,0,0,8" Padding="12,9" CornerRadius="8"
                                            Background="{DynamicResource SurfaceBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:AnimatedIcon Classes="icon-sm" Kind="Sparkles"
                                                                   Stroke="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding PredictText}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Tests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TestEditor">
                                                <Border Classes="test-card" Classes.passed="{Binding IsPassed}"
                                                        Classes.failed="{Binding IsFailed}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                            <controls:AnimatedIcon Classes="icon-sm" Kind="{Binding Icon}"
                                                                                   Stroke="{DynamicResource AccentBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding KindText}" Margin="8,0,12,0"
                                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBox Grid.Column="2" Classes="field" Padding="8,4" FontSize="12"
                                                                     Text="{Binding Label}" Watermark="{Binding AutoLabel}"
                                                                     ToolTip.Tip="Descripción que verán los estudiantes" />
                                                            <Panel Grid.Column="3">
                                                                <Border Classes="check-badge" Classes.shown="{Binding IsPassed}"
                                                                        Background="{DynamicResource RunGreenBrush}">
                                                                    <controls:AnimatedIcon Classes="icon-sm" Kind="Check" Stroke="White"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Classes="check-badge" Classes.shown="{Binding IsFailed}"
                                                                        Background="{DynamicResource StopRedBrush}">
                                                                    <controls:AnimatedIcon Classes="icon-sm" Kind="X" Stroke="White"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Panel>
                                                            <Button Grid.Column="4" Classes="class-icon danger" Margin="6,0,0,0"
                                                                    ToolTip.Tip="Quitar prueba" Command="{Binding RemoveCommand}"
                                                                    IsVisible="{Binding !IsComputed}">
                                                                <controls:AnimatedIcon Classes="icon-sm" Kind="X" />
                                                            </Button>
                                                        </Grid>
                                                        <WrapPanel IsVisible="{Binding IsPacket}" ItemSpacing="8" LineSpacing="8">
                                                            <ComboBox ItemsSource="{x:Static vm:TestEditor.Protocols}"
                                                                      SelectedItem="{Binding Protocol}" Width="84" />
                                                            <NumericUpDown Value="{Binding Port}" Minimum="0" Maximum="65535"
                                                                           Increment="1" FormatString="0" Width="120"
                                                                           Watermark="Puerto" />
                                                            <TextBox Classes="field" Text="{Binding Source}" Width="130"
                                                                     Watermark="Origen" ToolTip.Tip="Dirección de origen" />
                                                            <TextBlock Text="→" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBox Classes="field" Text="{Binding Destination}" Width="130"
                                                                     Watermark="Destino" ToolTip.Tip="Dirección de destino" />
                                                        </WrapPanel>
                                                        <StackPanel IsVisible="{Binding IsVariable}" Orientation="Horizontal" Spacing="8">
                                                            <TextBox Classes="field" Text="{Binding Name}" Width="150"
                                                                     Watermark="Nombre" />
                                                            <ComboBox ItemsSource="{x:Static vm:TestEditor.VariableTypes}"
                                                                      SelectedItem="{Binding VariableType}" Width="130" />
                                                            <TextBox Classes="field" Text="{Binding Value}" Width="170"
                                                                     Watermark="Valor (opcional)" />
                                                        </StackPanel>
                                                        <StackPanel IsVisible="{Binding HasExpect}" Orientation="Horizontal" Spacing="8">
                                                            <ToggleButton Classes="expect allow" IsChecked="{Binding ExpectsAllow}"
                                                                          Content="Debe pasar" />
                                                            <ToggleButton Classes="expect block" IsChecked="{Binding ExpectsBlock}"
                                                                          Content="Debe bloquearse" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel IsVisible="{Binding CanTestSolution}" Margin="0,0,0,24">
                                        <TextBlock Classes="label" Text="Tu solución (solo la ves tú)" />
                                        <Border CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <controls:CodeBox Code="{Binding Solution}" Height="150" ShowLineNumbers="True"
                                                              Background="{DynamicResource EditorBackgroundBrush}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              LineNumbersForeground="{DynamicResource TextDisabledBrush}"
                                                              FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                                              FontSize="13" Padding="6" />
                                        </Border>
                                        <Button Classes="class-primary" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Command="{Binding TestSolutionCommand}" IsEnabled="{Binding !IsTesting}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:AnimatedIcon Kind="Play" Width="14" Height="14" Stretch="Uniform"
                                                                       Stroke="White" StrokeThickness="2" />
                                                <TextBlock Text="Probar con mi solución" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <Border Classes="solution-result swap" Classes.shown="{Binding HasSolutionResult}"
                                                Classes.passed="{Binding SolutionPassed}" Classes.testing="{Binding IsTesting}">
                                            <TextBlock Text="{Binding SolutionText}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TransitioningContentControl.ContentTemplate>
                </TransitioningContentControl>
            </Grid>
        </DockPanel>

        <Border Name="Notice" Classes="class-notice">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <controls:AnimatedIcon Name="NoticeIcon" Classes="icon-sm" Kind="CircleAlert"
                                       Stroke="{DynamicResource StopRedBrush}" VerticalAlignment="Center" />
                <TextBlock Name="NoticeText" FontSize="13" MaxWidth="500" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
