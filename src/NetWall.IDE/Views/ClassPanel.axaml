<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetWall.IDE.ViewModels"
             xmlns:controls="using:NetWall.IDE.Controls"
             x:Class="NetWall.IDE.Views.ClassPanel"
             x:DataType="vm:ClassViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector=":is(Control).class-view">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(12px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Control).class-view.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Button.class-primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.class-primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="Button.class-primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.class-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.class-card">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.34" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.class-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>
        <Style Selector="Border.class-card controls|AnimatedIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.class-notice">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,28" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StopRedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 22 0 #66000000" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(14px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.class-notice.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <StackPanel Classes="class-view" Classes.shown="{Binding HasNoClass}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
            <TextBlock Text="Modo Clase" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Lleva tus ejercicios al laboratorio de redes" FontSize="14" HorizontalAlignment="Center"
                       Margin="0,6,0,26" Foreground="{DynamicResource TextMutedBrush}" />
            <Button Classes="class-primary" HorizontalAlignment="Center" Click="OnOpenClassClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:AnimatedIcon Kind="FolderOpen" Width="16" Height="16" Stretch="Uniform"
                                           Stroke="White" StrokeThickness="2" />
                    <TextBlock Text="Abrir clase" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DockPanel Classes="class-view" Classes.shown="{Binding HasClass}" Margin="48,34" MaxWidth="820">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding ClassName}" FontSize="28" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ExerciseCountText}" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="simulation-exit" VerticalAlignment="Top" Click="OnOpenClassClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:AnimatedIcon Classes="icon-sm" Kind="FolderOpen" />
                        <TextBlock Text="Abrir otra clase" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Exercises}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClassExerciseCard">
                            <Border Classes="class-card">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:AnimatedIcon Kind="{Binding Icon}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Exercise.Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding TypeText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TestsText}" FontSize="11.5" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border Name="Notice" Classes="class-notice">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <controls:AnimatedIcon Classes="icon-sm" Kind="CircleAlert" Stroke="{DynamicResource StopRedBrush}"
                                       VerticalAlignment="Center" />
                <TextBlock Name="NoticeText" FontSize="13" MaxWidth="500" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
